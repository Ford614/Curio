<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Color Palette -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHeaderBackgroundBrush" Color="#F0F4F9"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
    
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryAccentForegroundBrush" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#F1F5F9"/>

    <SolidColorBrush x:Key="TabHeaderSelectedBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabHeaderUnselectedBackgroundBrush" Color="#F8FAFC"/>

    <!-- Shared semantic colors used by both Modern and XP styles. -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelSecondaryBackgroundBrush" Color="#F0F4F9"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="PreviewBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="StatusForegroundBrush" Color="#166534"/>
    <SolidColorBrush x:Key="StatusBorderBrush" Color="#86EFAC"/>
    <SolidColorBrush x:Key="SuccessAccentBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LogForegroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

</ResourceDictionary>
