<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Color Palette -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardHeaderBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#334155"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="PrimaryAccentForegroundBrush" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#334155"/>

    <SolidColorBrush x:Key="TabHeaderSelectedBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="TabHeaderUnselectedBackgroundBrush" Color="#0F172A"/>

    <!-- Shared semantic colors used by both Modern and XP styles. -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="PanelSecondaryBackgroundBrush" Color="#172033"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#475569"/>
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#172033"/>
    <SolidColorBrush x:Key="PreviewBorderBrush" Color="#475569"/>
    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#14532D"/>
    <SolidColorBrush x:Key="StatusForegroundBrush" Color="#BBF7D0"/>
    <SolidColorBrush x:Key="StatusBorderBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="SuccessAccentBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="LogForegroundBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>

</ResourceDictionary>
