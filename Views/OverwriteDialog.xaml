<Window x:Class="Curio.Views.OverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同名スキームの確認" Height="240" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="同名のカーソルスキームが既に存在します。" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="MessageTextBlock" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
            <TextBlock Text="新しいスキーム名: " VerticalAlignment="Center"/>
            <TextBox x:Name="NewNameTextBox" Width="240" Margin="8,0,0,0" Padding="4,2"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="上書き保存" Width="90" Height="28" Margin="0,0,8,0" Click="OverwriteButton_Click" IsDefault="True"/>
            <Button Content="別名で保存" Width="90" Height="28" Margin="0,0,8,0" Click="RenameButton_Click"/>
            <Button Content="キャンセル" Width="90" Height="28" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
