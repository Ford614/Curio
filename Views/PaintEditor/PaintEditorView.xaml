<UserControl x:Class="Curio.Views.PaintEditor.PaintEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}"/>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="10"
                Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="{DynamicResource EditorNew}"
                        Click="New_Click"
                        Margin="0,0,6,0"/>
                <Button Content="{DynamicResource EditorOpen}"
                        Click="Open_Click"
                        Margin="0,0,6,0"/>
                <Button x:Name="SaveButton"
                        Content="{DynamicResource EditorSave}"
                        Click="Save_Click"
                        Background="{DynamicResource PrimaryAccentBrush}"
                        Foreground="{DynamicResource PrimaryAccentForegroundBrush}"
                        Margin="0,0,16,0"/>
                <Button Content="{DynamicResource EditorBack}"
                        Click="Back_Click"
                        Margin="0,0,16,0"/>

                <TextBlock Text="{DynamicResource Tools}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,6,0"/>
                <Button x:Name="PencilButton"
                        Content="{DynamicResource Pencil}"
                        Click="Pencil_Click"
                        Margin="0,0,4,0"/>
                <Button x:Name="EraserButton"
                        Content="{DynamicResource Eraser}"
                        Click="Eraser_Click"
                        Margin="0,0,4,0"/>
                <Button x:Name="EyedropperButton"
                        Content="{DynamicResource Eyedropper}"
                        Click="Eyedropper_Click"
                        Margin="0,0,4,0"/>
                <Button x:Name="FillButton"
                        Content="{DynamicResource Fill}"
                        Click="Fill_Click"
                        Margin="0,0,4,0"/>
                <Button x:Name="SelectButton"
                        Content="{DynamicResource Select}"
                        Click="Select_Click"
                        Margin="0,0,16,0"/>

                <TextBlock Text="{DynamicResource Brush}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="BrushSizeComboBox"
                          Width="80"
                          SelectionChanged="BrushSizeComboBox_SelectionChanged"
                          Margin="0,0,16,0">
                    <ComboBoxItem Content="1 px" Tag="1"/>
                    <ComboBoxItem Content="2 px" Tag="2"/>
                    <ComboBoxItem Content="3 px" Tag="3"/>
                    <ComboBoxItem Content="4 px" Tag="4"/>
                    <ComboBoxItem Content="6 px" Tag="6"/>
                </ComboBox>

                <Button Content="{DynamicResource Undo}"
                        Click="Undo_Click"
                        x:Name="UndoButton"
                        Margin="0,0,4,0"/>
                <Button Content="{DynamicResource Redo}"
                        Click="Redo_Click"
                        x:Name="RedoButton"/>
                <Button Content="{DynamicResource FlipHorizontal}"
                        Click="FlipHorizontal_Click"
                        Margin="8,0,4,0"/>
                <Button Content="{DynamicResource FlipVertical}"
                        Click="FlipVertical_Click"
                        Margin="0,0,4,0"/>
                <Button Content="{DynamicResource Copy}"
                        Click="CopySelection_Click"
                        Margin="0,0,4,0"/>
                <Button Content="{DynamicResource Paste}"
                        Click="PasteSelection_Click"
                        Margin="0,0,4,0"/>
                <Button Content="{DynamicResource DeleteSelection}"
                        Click="DeleteSelection_Click"
                        Margin="0,0,4,0"/>
                <ComboBox x:Name="CanvasSizeComboBox"
                          Width="86"
                          ToolTip="キャンバスサイズ"
                          Margin="8,0,4,0">
                    <ComboBoxItem Content="16×16" Tag="16"/>
                    <ComboBoxItem Content="24×24" Tag="24"/>
                    <ComboBoxItem Content="32×32" Tag="32"/>
                    <ComboBoxItem Content="48×48" Tag="48"/>
                    <ComboBoxItem Content="64×64" Tag="64"/>
                    <ComboBoxItem Content="96×96" Tag="96"/>
                    <ComboBoxItem Content="128×128" Tag="128"/>
                    <ComboBoxItem Content="256×256" Tag="256"/>
                </ComboBox>
                <Button Content="{DynamicResource Resize}"
                        Click="ResizeCanvas_Click"
                        Margin="0,0,8,0"/>
                <CheckBox x:Name="GridCheckBox"
                          Content="{DynamicResource Grid}"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Checked="GridCheckBox_Changed"
                          Unchecked="GridCheckBox_Changed"
                          Margin="12,0,0,0"/>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="12">
                <Canvas x:Name="PixelCanvas"
                        Width="512"
                        Height="512"
                        Background="{DynamicResource EditorCanvasBackgroundBrush}"
                        MouseLeftButtonDown="PixelCanvas_MouseLeftButtonDown"
                        MouseMove="PixelCanvas_MouseMove"
                        MouseLeftButtonUp="PixelCanvas_MouseLeftButtonUp">
                    <Image x:Name="CanvasImage"
                           Width="512"
                           Height="512"
                           Stretch="Fill"
                           IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Canvas x:Name="GridOverlay"
                            Width="512"
                            Height="512"
                            IsHitTestVisible="False"/>
                    <Canvas x:Name="SelectionOverlay"
                            Width="512"
                            Height="512"
                            IsHitTestVisible="False"/>
                    <Line x:Name="HotspotVerticalLine"
                          Stroke="#E05252"
                          StrokeThickness="1"
                          IsHitTestVisible="False"/>
                    <Line x:Name="HotspotHorizontalLine"
                          Stroke="#E05252"
                          StrokeThickness="1"
                          IsHitTestVisible="False"/>
                    <Ellipse x:Name="HotspotMarker"
                             Width="9"
                             Height="9"
                             Stroke="#FFFFFF"
                             Fill="#E05252"
                             StrokeThickness="1"
                             IsHitTestVisible="False"/>
                </Canvas>
            </Border>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="14,0,0,0">
                <StackPanel>
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Color}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <Border x:Name="ColorPreview"
                                        Width="34"
                                        Height="34"
                                        Background="#FFFFFF"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,8,0"/>
                                <TextBox x:Name="HexColorTextBox"
                                         Width="92"
                                         VerticalContentAlignment="Center"
                                         Text="#FFFFFF"
                                         ToolTip="#RRGGBB または #AARRGGBB"/>
                                <Button Content="{DynamicResource Apply}"
                                        Click="ApplyHexColor_Click"
                                        Margin="6,0,0,0"/>
                            </StackPanel>
                            <WrapPanel>
                                <Button Width="26" Height="26" Padding="0" Background="#000000" Click="ColorSwatch_Click"/>
                                <Button Width="26" Height="26" Padding="0" Background="#FFFFFF" Click="ColorSwatch_Click"/>
                                <Button Width="26" Height="26" Padding="0" Background="#E05252" Click="ColorSwatch_Click"/>
                                <Button Width="26" Height="26" Padding="0" Background="#F59E0B" Click="ColorSwatch_Click"/>
                                <Button Width="26" Height="26" Padding="0" Background="#22C55E" Click="ColorSwatch_Click"/>
                                <Button Width="26" Height="26" Padding="0" Background="#3B82F6" Click="ColorSwatch_Click"/>
                                <Button Width="26" Height="26" Padding="0" Background="#A855F7" Click="ColorSwatch_Click"/>
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource Opacity}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,12,0,2"/>
                            <Slider x:Name="AlphaSlider"
                                    Minimum="0"
                                    Maximum="255"
                                    Value="255"
                                    ValueChanged="AlphaSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Hotspot}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource HotspotDescription}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="HotspotXTextBox" Grid.Column="1" Text="0"/>
                                <TextBlock Text="Y" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                <TextBox x:Name="HotspotYTextBox" Grid.Column="3" Text="0"/>
                            </Grid>
                            <Button Content="{DynamicResource Apply}"
                                    Click="ApplyHotspot_Click"
                                    Margin="0,8,0,0"/>
                            <Button x:Name="SetHotspotButton"
                                    Content="{DynamicResource SetHotspotOnCanvas}"
                                    Click="SetHotspot_Click"
                                    Margin="0,4,0,0"/>
                            <TextBlock x:Name="EditorStatusTextBlock"
                                       Text="32×32 CUR"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </ScrollViewer>

        <Border x:Name="TimelinePanel"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CardCornerRadius}"
                Padding="8"
                Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <Button x:Name="PlayButton"
                            Content="{DynamicResource Play}"
                            Click="Play_Click"
                            Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource Stop}"
                            Click="Stop_Click"
                            Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource EmptyFrame}"
                            Click="AddEmptyFrame_Click"
                            Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource Duplicate}"
                            Click="DuplicateFrame_Click"
                            Margin="0,0,4,0"/>
                    <Button Content="{DynamicResource Delete}"
                            Click="DeleteFrame_Click"
                            Margin="0,0,4,0"/>
                    <Button Content="↑"
                            Click="MoveFrameUp_Click"
                            Margin="0,0,2,0"/>
                    <Button Content="↓"
                            Click="MoveFrameDown_Click"
                            Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource DurationMs}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,6,0"/>
                    <TextBox x:Name="FrameDurationTextBox"
                             Width="64"
                             Text="100"
                             VerticalContentAlignment="Center"
                             Margin="0,0,4,0"/>
                            <Button Content="{DynamicResource Apply}"
                            Click="ApplyFrameDuration_Click"/>
                </WrapPanel>
                <ListBox x:Name="TimelineListBox"
                         Grid.Row="1"
                         Height="86"
                         Margin="0,8,0,0"
                         BorderThickness="0"
                         SelectionChanged="TimelineListBox_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   x:Name="FooterTextBlock"
                   Text="{DynamicResource EditorFooter}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="2,10,0,0"/>
    </Grid>
</UserControl>
