<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Curio"
      Manufacturer="Ford614"
      Version="1.0.0.0"
      UpgradeCode="2cdff0f7-5f7e-4f42-8855-a5a154a3a494"
      Scope="perMachine"
      Codepage="932">

    <!-- アプリケーションアイコン -->
    <Icon
        Id="CurioIcon"
        SourceFile="Assets\Curio.ico" />

    <Property
        Id="ARPPRODUCTICON"
        Value="CurioIcon" />

    <!-- アップグレード設定 -->
    <MajorUpgrade
        DowngradeErrorMessage="Curioの新しいバージョンがすでにインストールされています。" />

    <MediaTemplate EmbedCab="yes" />

    <!-- ============================== -->
    <!-- インストール先 -->
    <!-- ============================== -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory
          Id="INSTALLFOLDER"
          Name="Curio" />
    </StandardDirectory>

    <!-- ============================== -->
    <!-- スタートメニュー -->
    <!-- ============================== -->

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory
          Id="ApplicationProgramsFolder"
          Name="Curio" />
    </StandardDirectory>

    <!-- ============================== -->
    <!-- デスクトップ -->
    <!-- ============================== -->

    <StandardDirectory Id="DesktopFolder" />

    <!-- ============================== -->
    <!-- publishフォルダを丸ごとインストール -->
    <!-- ============================== -->

    <ComponentGroup
        Id="CurioFiles"
        Directory="INSTALLFOLDER">

      <Files
          Include="$(var.PublishDir)\**" />

    </ComponentGroup>

    <!-- ============================== -->
    <!-- スタートメニューショートカット -->
    <!-- ============================== -->

    <Component
        Id="StartMenuShortcutComponent"
        Directory="ApplicationProgramsFolder"
        Bitness="always64">

      <Shortcut
          Id="StartMenuShortcut"
          Name="Curio"
          Description="マウスカーソルインストーラー"
          Target="[INSTALLFOLDER]Curio.exe"
          WorkingDirectory="INSTALLFOLDER" />

      <RemoveFolder
          Id="RemoveApplicationProgramsFolder"
          On="uninstall" />

      <RegistryValue
          Root="HKCU"
          Key="Software\Ford614\Curio"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />

    </Component>

    <!-- ============================== -->
    <!-- デスクトップショートカット -->
    <!-- ============================== -->

    <Component
        Id="DesktopShortcutComponent"
        Directory="DesktopFolder"
        Bitness="always64">

      <Shortcut
          Id="DesktopShortcut"
          Name="Curio"
          Description="マウスカーソルインストーラー"
          Target="[INSTALLFOLDER]Curio.exe"
          WorkingDirectory="INSTALLFOLDER" />

      <RegistryValue
          Root="HKCU"
          Key="Software\Ford614\Curio"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />

    </Component>

    <!-- ============================== -->
    <!-- Feature -->
    <!-- ============================== -->

    <Feature
        Id="MainFeature"
        Title="Curio"
        Level="1">

      <!-- Curio本体 -->
      <ComponentGroupRef
          Id="CurioFiles" />

      <!-- スタートメニュー -->
      <Feature
          Id="StartMenuFeature"
          Title="スタートメニュー"
          Description="スタートメニューにCurioのショートカットを作成します。"
          Level="1">

        <ComponentRef
            Id="StartMenuShortcutComponent" />

      </Feature>

      <!-- デスクトップ -->
      <Feature
          Id="DesktopFeature"
          Title="デスクトップショートカット"
          Description="デスクトップにCurioのショートカットを作成します。"
          Level="1">

        <ComponentRef
            Id="DesktopShortcutComponent" />

      </Feature>

    </Feature>

    <!-- ============================== -->
    <!-- WiX標準インストーラーUI -->
    <!-- ============================== -->

    <ui:WixUI
        Id="WixUI_FeatureTree"
        InstallDirectory="INSTALLFOLDER" />

  </Package>

</Wix>